# ArchGuard — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Gemma 4 API key (used by dag_extractor.py for live visual extraction).
# Obtain from the MLH Gemma quickstart or Google AI Studio.
# If you pass --edges <contract.json> to the CLI, this key is NOT required.
GEMMA_API_KEY=your_gemma_api_key_here

# Alternatively, some configurations use GOOGLE_API_KEY.
# Only one of the two is needed.
GOOGLE_API_KEY=your_google_api_key_here

# Optional model override for the live extractor.
ARCHGUARD_MODEL=gemma-3-27b-it
