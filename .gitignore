# ArchGuard — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
.env

# Secrets — never commit real keys
*.key
*.pem
*.secret

# IDE
.vscode/settings.json
.idea/
*.iml

# Generated reports (not source — regenerated by the tool)
drift_report.md
drift_report.html

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Scratch scripts
make_arch_png.py
